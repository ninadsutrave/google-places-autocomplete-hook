{
  "name": "placeahead",
  "version": "0.1.0",
  "description": "React hook for Google Places Autocomplete on the Places API (New), with session tokens handled for you and a drop-in mode for use-places-autocomplete",
  "license": "MIT",
  "author": "Ninad Sutrave",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninadsutrave/placeahead.git"
  },
  "keywords": [
    "react",
    "hook",
    "google",
    "places",
    "autocomplete",
    "places-api-new",
    "google-maps",
    "address",
    "use-places-autocomplete"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "compat"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run lint:package",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:package": "publint"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "homepage": "https://github.com/ninadsutrave/placeahead#readme",
  "bugs": {
    "url": "https://github.com/ninadsutrave/placeahead/issues"
  }
}
