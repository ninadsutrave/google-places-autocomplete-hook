{
  "name": "google-places-autocomplete-hook",
  "version": "0.1.10",
  "description": "React hook for Google Places Autocomplete on the Places API (New), with session tokens handled for you and a drop-in mode for use-places-autocomplete",
  "license": "MIT",
  "author": {
    "name": "Ninad Sutrave",
    "url": "https://ninadsutrave.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninadsutrave/google-places-autocomplete-hook.git"
  },
  "keywords": [
    "react",
    "react-hook",
    "hook",
    "hooks",
    "google",
    "google-maps",
    "google-maps-api",
    "google-maps-javascript-api",
    "google-places",
    "google-places-api",
    "google-places-autocomplete",
    "places",
    "places-api",
    "places-api-new",
    "places-autocomplete",
    "place-autocomplete",
    "place-details",
    "autocomplete",
    "autocomplete-suggestion",
    "address",
    "address-autocomplete",
    "address-search",
    "location",
    "location-search",
    "geocoding",
    "session-token",
    "headless",
    "typeahead",
    "combobox",
    "typescript",
    "ssr",
    "use-places-autocomplete",
    "react-places-autocomplete",
    "react-google-places-autocomplete",
    "react-google-autocomplete"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "compat"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run lint:package",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:package": "publint"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.0"
  },
  "homepage": "https://ninadsutrave.github.io/google-places-autocomplete-hook/",
  "bugs": {
    "url": "https://github.com/ninadsutrave/google-places-autocomplete-hook/issues"
  }
}
